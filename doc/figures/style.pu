' Not-ugly plantuml style defaults

skinparam defaultFontName  Helvetica
skinparam sequenceMessageAlign center
skinparam roundCorner 15

skinparam activity {
	ArrowColor Black
	BackgroundColor White
	BorderColor Black
	BorderThickness 1
}

skinparam node {
	ArrowColor Black
	BackgroundColor White
	BorderColor Black
}

skinparam cloud {
	ArrowColor Black
	BackgroundColor White
	BorderColor Black
}

